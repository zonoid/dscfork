<project name="stratum-library" default="update_localhost" basedir=".">
    <description>Ant Build File for Joomla</description>

    <!-- load variables from config file -->
    <property name="cfg.configFile" location="antconfig.txt" />
    <loadproperties srcfile="${cfg.configFile}" />

    <!--config file values
    cfg.name=sample
    cfg.buildDir=packages
    cfg.localhostRoot=c:/www
    
    ftp.server=
    ftp.user=
    ftp.password=
    ftp.dir=    
    -->


  <target name="update_localhost" description="attemps to update files on localhost server with files from working directory">
    <!-- MAIN COMPONENT -->
    <copy todir="${cfg.localhostRoot}/libraries/stratum/component" overwrite="true">
      <fileset dir="lib_stratum/component" />
    </copy>
    <copy todir="${cfg.localhostRoot}/libraries/stratum/highroller" overwrite="true">
      <fileset dir="lib_stratum/highroller" />
    </copy>
    <copy todir="${cfg.localhostRoot}/libraries/stratum/library" overwrite="true">
      <fileset dir="lib_stratum/library" />
    </copy>
    <copy todir="${cfg.localhostRoot}/libraries/stratum/tools" overwrite="true">
      <fileset dir="lib_stratum/tools" />
    </copy>
	<copy todir="${cfg.localhostRoot}/libraries/stratum" overwrite="true">
      <fileset file="lib_stratum/stratum.php" />
    </copy>
	<copy todir="${cfg.localhostRoot}/libraries/stratum" overwrite="true">
      <fileset file="lib_stratum/loader.php" />
    </copy>

    <!-- MEDIA FILES -->
    <copy todir="${cfg.localhostRoot}/media/stratum" overwrite="true">
        <fileset dir="lib_stratum/media" />
    </copy>
    <!-- LANGUAGE FILES -->
    <copy todir="${cfg.localhostRoot}/language/en-GB" overwrite="true">
        <fileset dir="lib_stratum/language/en-GB" />
    </copy>
  </target>
  
  
    <target name="clean" description="Destroys all generated files and dirs">
        <delete dir="${cfg.buildDir}/stratum_library" />
    </target>

    <target name="init" description="creates necessary directory to build with">
        <mkdir dir="${cfg.buildDir}/stratum_library" />
    </target>

    <target name="build" depends="build_packages" />
    
    <target name="build_packages" depends="clean, init, build_library, build_system_plugin, build_system_plugin_for_j15" />

    <target name="build_library" depends="init" description="packages the library">
        <zip destfile="${cfg.buildDir}/stratum_library/stratum_library.zip" basedir="${basedir}/lib_stratum" />
    </target>
    
    <target name="build_system_plugin" depends="init" description="packages the sys plugin">
        <zip destfile="${cfg.buildDir}/stratum_library/stratum_plugin_system.zip" basedir="${basedir}/plg_system_stratum" excludes="stratum.xml.j15" />
    </target>

    <target name="build_system_plugin_for_j15" description="packages the system plugin and library for j15 installation">
        <delete dir="${cfg.buildDir}/stratum_library/j15" />
        <delete file="${cfg.buildDir}/stratum_library/stratum_plugin_system_j15x.zip"/>
        <mkdir dir="${cfg.buildDir}/stratum_library/j15" />
                
        <!-- MAIN PLUGIN -->
        <copy todir="${cfg.buildDir}/stratum_library/j15" preservelastmodified="true" overwrite="true">
            <fileset dir="${basedir}/plg_system_stratum" />
        </copy>
        <!-- LIBRARY -->
        <copy todir="${cfg.buildDir}/stratum_library/j15/stratum" preservelastmodified="true" overwrite="true">
            <fileset dir="${basedir}/lib_stratum" />
        </copy>
        
        <move file="${cfg.buildDir}/stratum_library/j15/stratum.xml.j15" tofile="${cfg.buildDir}/stratum_library/j15/stratum.xml" overwrite="true" />
        
        <delete file="${cfg.buildDir}/stratum_library/j15/stratum/stratum.xml"/>
        
        <zip destfile="${cfg.buildDir}/stratum_library/stratum_plugin_system_j15x.zip" basedir="${cfg.buildDir}/stratum_library/j15" />
    </target>
</project>
