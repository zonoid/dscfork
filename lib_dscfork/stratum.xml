<?xml version="1.0" encoding="utf-8"?>
<!-- TODO: J4/5 review the version attribute in the extension tag. Joomla 4/5 might expect "4.0" or "5.0", or it might not be strictly necessary for libraries. -->
<extension type="library" method="upgrade" version="3.0">
	<name>Stratum Library</name>
	<libraryname>stratum</libraryname>
	<author>Gerald R. Zalsos</author>
	<creationDate>2024</creationDate>
	<copyright>Copyright (C) 2024 klaraontheweb.com All rights reserved.</copyright>
	<license>GNU General Public License version 2 or later</license>
	<authorEmail>info@klaraontheweb.com</authorEmail>
	<authorUrl>www.klaraontheweb.com</authorUrl>
	<version>5.0.0</version>
	<description>
	<![CDATA[
	<div class="alert alert-info text-left">
		<h4>Stratum Library</h4>
		<p>Updated library for Joomla 4/5 compatibility. Originally a fork of Dioscouri Library.</p>
	</div>	
	]]>		
	</description>
	
	<files>		
		<folder>component</folder>
		<folder>highroller</folder>
		<folder>library</folder>
		<folder>tools</folder>
		<file>stratum.php</file>
		<file>loader.php</file>
	</files>
	<languages folder="language">
		<language tag="en-GB">en-GB/en-GB.lib_stratum.ini</language>
	</languages>

	<!-- Media -->
	<media destination="stratum" folder="media">
		<folder>css</folder>		
		<folder>images</folder>
		<folder>js</folder>		
		<file>index.html</file>
	</media>
	<updateservers>
		<server type="extension" priority="1" name="Stratum Library Updates">http://updates.klaraontheweb.com/library/updates.xml</server>
	</updateservers>

</extension>